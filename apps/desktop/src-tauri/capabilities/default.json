{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window / mobile webview",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:deny-create",
    "core:webview:deny-create-webview",
    "core:webview:deny-create-webview-window",
    "dialog:default",
    "fs:allow-start-accessing-security-scoped-resource",
    "fs:allow-stop-accessing-security-scoped-resource",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$APPDATA/imports" },
        { "path": "$APPDATA/imports/**" },
        { "path": "$APPDATA/models" },
        { "path": "$APPDATA/models/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "$APPDATA/imports" },
        { "path": "$APPDATA/imports/**" },
        { "path": "$APPDATA/models" },
        { "path": "$APPDATA/models/**" }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        { "path": "$APPDATA/imports" },
        { "path": "$APPDATA/imports/**" }
      ]
    },
    {
      "identifier": "fs:allow-copy-file",
      "allow": [
        { "path": "$APPDATA/models" },
        { "path": "$APPDATA/models/**" }
      ]
    }
  ]
}
