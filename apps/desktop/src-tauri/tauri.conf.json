{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PKB",
  "version": "0.1.0",
  "identifier": "com.ai-shizu.pkb",
  "build": {
    "beforeDevCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-dev.ps1",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-build.ps1",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PKB",
        "width": 1200,
        "height": 800,
        "visible": true,
        "center": true,
        "backgroundColor": "#0f1419"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Personal Knowledge Base — 完全オフライン意思決定支援",
    "longDescription": "日記・予定・家計簿・AI相談を統合し、ローカル LLM で意思決定を支援するデスクトップアプリ。外部 API は使用しません。",
    "externalBin": [
      "binaries/pkb-engine"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
